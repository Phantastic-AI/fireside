{
  // Fireside — one Worker, everything through it.
  "name": "fireside",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "routes": [
    // onfireside.com is the brand front; the apex is canonical and www
    // redirects to it in the Worker (see src/index.ts). fireside.phantastic.ai
    // stays a working alias so no published link, demo login, or OAuth
    // redirect breaks during the move.
    {
      "pattern": "onfireside.com",
      "custom_domain": true
    },
    {
      "pattern": "www.onfireside.com",
      "custom_domain": true
    },
    {
      "pattern": "fireside.phantastic.ai",
      "custom_domain": true
    }
  ],
  "vars": {
    "RESEED_ENABLED": "true",
    "GOOGLE_CLIENT_ID": "92329243256-ieg544bl92lk19u7abi05aifut45be5s.apps.googleusercontent.com",
    "FROM_EMAIL": "mail@fireside.phantastic.ai"
  },
  "rules": [
    {
      "type": "Text",
      // stars.js is raw text served at /a/stars.js; cfp.js stays a bundled
      // module (it exports its own source via toString) — do not widen this.
      "globs": ["**/*.css", "**/islands/stars.js"],
      "fallthrough": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fireside",
      "database_id": "b52c4fa2-3ae7-4d6c-885f-bcde33b40437"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "fireside-files"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "triggers": {
    // Daily at 6 AM Pacific (13:00 UTC in summer): the demonstration world
    // rebuilds itself once a night, not once an hour — a visitor's afternoon
    // of clicking around survives until morning.
    "crons": ["0 13 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
